// The agent's orb: a glass bead of colored light whose blobs drift
// through each other, faster as it works, lit from the top left, with a
// soft halo.

var Phase float

// Energy is how lively it is, from 0, at rest, to 1, working.
var Energy float

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	s := min(size.x, size.y)
	inner := s * 0.5 / 1.2
	uv := (pos - 0.5*size) / inner
	r := length(uv)
	t := Phase
	if r > 1 {
		halo := exp(-(r-1)*6) * (0.18 + 0.3*Energy) * (1 - smoothstep(1.02, 1.2, r))
		c := palette(t*0.05 + around(uv, vec2(1)))
		return vec4(c*halo, halo)
	}
	z := sqrt(max(1-r*r, 0))
	n := vec3(uv, z)
	w := uv * (1.1 + 0.15*z)
	w += (0.2 + 0.25*Energy) * vec2(sin(w.y*2.7+t*1.1), cos(w.x*2.3-t*0.9))
	col := vec3(0.06, 0.07, 0.2)
	for i := 0; i < 4; i++ {
		f := float(i)
		c := 0.55 * vec2(sin(t*(0.5+0.13*f)+f*2.1), cos(t*(0.43+0.11*f)+f*1.3))
		k := exp(-dot(w-c, w-c) * 3.2)
		col += palette(f/4+t*0.03) * k * 0.9
	}
	rim := pow(1-z, 2.4)
	col *= 0.72 + 0.38*z
	col += palette(around(uv, vec2(1))+t*0.05) * rim * 0.75
	spec := pow(max(dot(n, normalize(vec3(-0.45, -0.6, 0.66))), 0), 40)
	col += vec3(1) * spec * 0.65
	// Edges rising, as GLSL defines smoothstep for those alone.
	alpha := 1 - smoothstep(1-1.5/(inner*pixelScale()), 1, r)
	return vec4(min(col, 1)*alpha, alpha)
}
