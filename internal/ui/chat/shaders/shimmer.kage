// Text at work: its color with a band of light sweeping across it, again
// and again.

var Time float
var Base vec4
var Shine vec4

func Fragment(dst vec4, pos vec2) vec4 {
	x := pos.x / rectSize().x
	s := fract(Time*0.55)*2.2 - 0.6
	k := exp(-(x-s)*(x-s)*12)
	c := mix(Base, Shine, k)
	return vec4(c.rgb*c.a, c.a)
}
