// The message field's ring: a thin line around it, Pad DIPs in from the
// box, with corners of Radius, glowing outward, its colors flowing around
// it; faint with the focus, bright as the agent works.

var Time float
var Strength float
var Pad float
var Radius float

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	p := pos - 0.5*size
	d := roundRect(p, 0.5*size-Pad, Radius) - 0.5
	flow := around(p, size) + Time*0.1
	line := exp(-abs(d) / 0.8)
	glow := 0.0
	if d > 0 {
		glow = (exp(-d/4)*0.5 + exp(-d/10)*0.25) * (1 - smoothstep(Pad*0.3, Pad, d))
	}
	alpha := clamp(line*(0.35+0.65*Strength)+glow*Strength, 0, 1)
	col := mix(palette(flow), palette(flow+0.2), glow/(line+glow+0.0001))
	return vec4(col*alpha, alpha)
}
