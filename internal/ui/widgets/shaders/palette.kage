// The chat's colors, around a loop from 0 to 1: blue, cyan, indigo,
// violet and pink, about the app's accent.
func palette(x float) vec3 {
	x = fract(x) * 5
	if x < 1 {
		return mix(vec3(0.23, 0.51, 0.96), vec3(0.13, 0.78, 0.93), x)
	}
	if x < 2 {
		return mix(vec3(0.13, 0.78, 0.93), vec3(0.39, 0.40, 0.95), x-1)
	}
	if x < 3 {
		return mix(vec3(0.39, 0.40, 0.95), vec3(0.55, 0.36, 0.96), x-2)
	}
	if x < 4 {
		return mix(vec3(0.55, 0.36, 0.96), vec3(0.93, 0.36, 0.66), x-3)
	}
	return mix(vec3(0.93, 0.36, 0.66), vec3(0.23, 0.51, 0.96), x-4)
}

// roundRect is the distance from p, from the rectangle's middle, to a
// rectangle of half size half with corners of radius r: below zero
// inside.
func roundRect(p, half vec2, r float) float {
	q := abs(p) - half + r
	return length(max(q, 0)) + min(max(q.x, q.y), 0) - r
}

// around is where p, from the middle of a box of size, lies around its
// outline, from 0 to 1.
func around(p, size vec2) float {
	return atan2(p.y/size.y, p.x/size.x)/6.2831853 + 0.5
}
